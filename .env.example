# GEMINI_API_KEY: Required on the server for Gemini AI calls.
# Never expose this key in client-side VITE_* variables.
# Configure via Settings > Secrets in AI Studio or a local .env file.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application (injected automatically in production).
APP_URL="http://localhost:3000"

# PORT: HTTP server port (AI Studio requires port 3000 in preview).
PORT="3000"

